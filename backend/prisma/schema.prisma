generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     String    @id @default(uuid())
  name                   String
  email                  String    @unique
  passwordHash           String?
  googleId               String?   @unique
  role                   Role      @default(PUBLIC_USER)
  isActive               Boolean   @default(true)
  lastLoginAt            DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  refreshTokenHash       String?   @map("refreshToken")
  resetPasswordExpiry    DateTime?
  resetPasswordTokenHash String?   @map("resetPasswordToken")
  emailVerifyExpiry      DateTime?
  emailVerifyTokenHash   String?   @map("emailVerifyToken")
  isVerified             Boolean   @default(false)
  photoUrl               String?   @default("")
  donations              Donation[]
}

model GalleryItem {
  id                 String           @id @default(uuid())
  title              String?
  description        String?
  imageUrl           String
  cloudinaryPublicId String?
  category           GalleryCategory?
  displayLocation    String?
  eventDate          DateTime?
  isFeatured         Boolean          @default(false)
  isPublished        Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model Program {
  id                 String   @id @default(uuid())
  title              String
  slug               String   @unique
  shortDescription   String?
  description        String?
  imageUrl           String?
  cloudinaryPublicId String?
  isFeatured         Boolean  @default(false)
  isPublished        Boolean  @default(true)
  displayOrder       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model TeamMember {
  id                 String   @id @default(uuid())
  name               String
  designation        String
  bio                String?
  responsibilities   String?
  expertise          String?
  department         String?
  photoUrl           String?
  cloudinaryPublicId String?
  displayOrder       Int      @default(0)
  isActive           Boolean  @default(true)
  isPublished        Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MediaCoverage {
  id                 String    @id @default(uuid())
  title              String
  publication        String
  description        String?
  thumbnailUrl       String?
  cloudinaryPublicId String?
  externalUrl        String
  category           String?
  displayLocation    String?
  publishedAt        DateTime?
  isFeatured         Boolean   @default(false)
  isPublished        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model DigitalLibrary {
  id                 String           @id @default(uuid())
  title              String
  description        String?
  category           LibraryCategory?
  fileUrl            String
  cloudinaryPublicId String?
  thumbnailUrl       String?
  fileType           String?
  fileSize           Int?
  isPublished        Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TransparencyDocument {
  id                 String    @id @default(uuid())
  title              String
  documentType       String
  documentNumber     String?
  documentUrl        String
  cloudinaryPublicId String?
  issuedDate         DateTime?
  description        String?
  isPublished        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Volunteer {
  id        String          @id @default(uuid())
  name      String
  mobile    String
  email     String?
  city      String?
  skills    String?
  interests String?
  message   String?
  status    VolunteerStatus @default(NEW)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model PartnerEnquiry {
  id               String        @id @default(uuid())
  organizationName String
  contactPerson    String
  email            String
  mobile           String
  organizationType String?
  message          String?
  status           PartnerStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String?
  mobile    String
  subject   String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model Donation {
  id                String         @id @default(uuid())
  donorName         String
  email             String?
  mobile            String
  pan               String?
  address           String?
  amount            Float
  currency          String         @default("INR")
  status            DonationStatus @default(CREATED)
  razorpayOrderId   String?        @unique
  razorpayPaymentId String?
  receiptNumber      String?        @unique
  receiptToken       String?        @unique
  receiptGeneratedAt DateTime?
  receiptEmailSentAt DateTime?
  receiptEmailAttemptedAt DateTime?
  userId            String?
  user              User?          @relation(fields: [userId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model ReceiptSequence {
  id            String   @id @default(uuid())
  financialYear String   @unique
  currentValue  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  CONTENT_ADMIN
  FINANCE_ADMIN
  PUBLIC_USER
}

enum GalleryCategory {
  FOOTPATH_EDUCATION
  SCHOOL_ADMISSION
  CHILDREN_IN_SCHOOL
  EDUCATIONAL_SUPPORT
  LEARNING_ACTIVITIES
  FOOD_COMMUNITY_SUPPORT
  FAMILY_SUPPORT
  BATH_TENT
  ENVIRONMENT
  SCHOOL_ACTIVITIES
  SPECIAL_MOMENTS
}

enum LibraryCategory {
  NCERT_BOOK
  NOTES
  STUDY_MATERIAL
  EDUCATIONAL_VIDEO
  PDF
  DIGITAL_LEARNING
  COMPETITIVE_EXAM
  OTHER
}

enum VolunteerStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum PartnerStatus {
  NEW
  CONTACTED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ContactStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum DonationStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model ImpactMetric {
  id            String   @id @default(uuid())
  value         Int
  label         String
  description   String?
  displayOrder  Int      @default(0)
  isPublished   Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

